type Vote = 
 record {
   inFavor: bool;
   timestamp: Timestamp;
   voter: UserId;
   votingPower: nat64;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type UserProfile = 
 record {
   icfcBalance: TokenAmt;
   lastBalanceCheck: Timestamp;
   name: text;
 };
type UserId = principal;
type TokenAmt = nat64;
type Timestamp = int;
type TimeSeriesBucket = 
 record {
   bucketLabel: text;
   bucketStart: Timestamp;
   callCount: nat32;
   totalCost: TokenAmt;
 };
type ThreadId = nat32;
type Thread = 
 record {
   author: UserId;
   createdAt: Timestamp;
   id: ThreadId;
   isDeleted: bool;
   posts: vec Post;
   title: text;
 };
type TemplateId = nat32;
type Template = 
 record {
   content: text;
   description: text;
   id: TemplateId;
   name: text;
 };
type RateLimitStatus = 
 record {
   currentWindowCalls: nat32;
   rateLimit: nat32;
   windowEndSecs: nat32;
   windowStart: Timestamp;
 };
type ProposalType = 
 variant {
   AdjustRateLimit;
   BackupSchema;
   BanUser;
   BatchOp;
   ChangeGovernance;
   ConfigureRealTimeFeeds;
   DeleteAPIPrice;
   DeleteAttribute;
   DeleteDashboard;
   DeleteDynamicDoc;
   DeleteMethod;
   DeleteObjectType;
   DeletePost;
   DeleteTemplate;
   DeleteThread;
   DisputeProposal;
   EditAPIPrice;
   EditAttribute;
   EditDashboard;
   EditDynamicDoc;
   EditMethod;
   EditObjectType;
   EditTemplate;
   ImportSeasonData;
   NewAPIPrice;
   NewAttribute;
   NewDashboard;
   NewDataCanister;
   NewDynamicDoc;
   NewForumCanister;
   NewMethod;
   NewObjectType;
   NewTemplate;
   PinPost;
   RestoreSchema;
   SetInitialData;
   SimulateProposal;
   TreasuryAction;
   UnbanUser;
   UpdateCSS;
   UpdateCanister;
   UpdateFrontend;
   UpdateHTML;
   UpdateMotoko;
 };
type ProposalStatus = 
 variant {
   Approved;
   Disputed;
   Executed;
   Finalized;
   Rejected;
   Simulated;
   Submitted;
   Voting;
 };
type ProposalId = nat32;
type Proposal = 
 record {
   content: text;
   createdAt: Timestamp;
   disputeWindowEnd: opt Timestamp;
   executionResult: opt text;
   id: ProposalId;
   proposalType: ProposalType;
   proposer: UserId;
   simulationResult: opt text;
   stake: TokenAmt;
   status: ProposalStatus;
   updatedAt: Timestamp;
   voters: vec Vote;
   votesAgainst: nat64;
   votesFor: nat64;
   votingEndsAt: Timestamp;
 };
type PostId = nat32;
type Post = 
 record {
   author: UserId;
   content: text;
   createdAt: Timestamp;
   id: PostId;
   isDeleted: bool;
   isPinned: bool;
 };
type Pct = nat8;
type ObjectType = 
 record {
   attributes: vec Attribute;
   createdAt: Timestamp;
   description: text;
   id: ObjectId;
   methods: vec MethodDefinition;
   name: text;
   updatedAt: Timestamp;
 };
type ObjectId = nat32;
type MethodId = nat32;
type MethodDefinition = 
 record {
   code: blob;
   description: text;
   id: MethodId;
   name: text;
 };
type ImportRecord = 
 record {
   blobId: BlobId;
   importedAt: nat64;
   importedBy: principal;
   proposalId: ProposalId;
   status: text;
 };
type GovernanceSettings = 
 record {
   autoShardingEnabled: bool;
   autoShardingThresholdGb: nat32;
   backupIntervalSecs: nat64;
   backupSubnetHint: text;
   defaultAPITokenId: APITokenId;
   defaultRateLimitPerMin: nat32;
   disputeReward: Pct;
   disputeWindow: nat64;
   heartbeatEnabled: bool;
   heartbeatIntervalSecs: nat64;
   minStake: TokenAmt;
   quorum: Pct;
   votingPeriod: nat64;
   vpAgeWeighting: Pct;
 };
type FeedResult = 
 record {
   bodySnippet: text;
   feedId: FeedId;
   fetchedAt: nat64;
   fullBodyBlobId: opt BlobId;
   responseCode: nat16;
 };
type FeedId = nat32;
type FeedConfig = 
 record {
   apiKeyHeader: opt text;
   apiKeyValue: opt text;
   createdBy: principal;
   enabled: bool;
   id: FeedId;
   lastFetchAt: nat64;
   lastFetchStatus: text;
   maxResponseBytes: nat32;
   name: text;
   pollIntervalSecs: nat64;
   url: text;
 };
type EventLogEntry = 
 record {
   details: text;
   eventType: text;
   hash: blob;
   id: EventId;
   previousHash: opt blob;
   timestamp: Timestamp;
 };
type EventId = nat32;
type DynamicDoc = 
 record {
   content: text;
   generatedAt: Timestamp;
   id: DocId;
   title: text;
 };
type DocId = nat32;
type DashboardConfig = 
 record {
   id: DashId;
   layout: text;
   user: UserId;
   widgets: vec text;
 };
type DashId = nat32;
type ConsumerId = nat32;
type BlobId = nat32;
type BlobEntry = 
 record {
   chunkCount: nat32;
   id: BlobId;
   isActive: bool;
   mimeType: text;
   name: text;
   sha256: opt blob;
   totalSize: nat32;
   uploadedAt: Timestamp;
   uploadedBy: principal;
 };
type BackupId = nat32;
type BackupEntry = 
 record {
   id: BackupId;
   objectCount: nat32;
   schemaBlob: blob;
   timestamp: Timestamp;
   triggeredBy: text;
 };
type Attribute = 
 record {
   dataType: text;
   defaultValue: opt text;
   id: AttrId;
   isRequired: bool;
   name: text;
 };
type AttrId = nat32;
type APITokenId = nat8;
type APIToken = 
 record {
   decimals: nat8;
   id: APITokenId;
   isActive: bool;
   ledgerId: principal;
   minDeposit: TokenAmt;
   symbol: text;
 };
type APIPricePackage = 
 record {
   batchSizeThreshold: nat8;
   id: APIPkgId;
   isActive: bool;
   name: text;
   objectTypeId: opt ObjectId;
   priceBatchCall: TokenAmt;
   pricePerCall: TokenAmt;
   tokenId: APITokenId;
 };
type APIPkgId = nat8;
type APIConsumerV2 = 
 record {
   apiKey: blob;
   balance: TokenAmt;
   batchCallCount: nat32;
   callCount: nat32;
   createdAt: Timestamp;
   id: ConsumerId;
   isActive: bool;
   lastCallAt: Timestamp;
   owner: UserId;
   rateLimit: nat32;
   tokenId: APITokenId;
   totalDeposited: TokenAmt;
   totalSpent: TokenAmt;
 };
type APIConsumer = 
 record {
   apiKey: text;
   createdAt: Timestamp;
   id: ConsumerId;
   "principal": UserId;
   requestsMade: nat32;
   usageLimit: nat32;
 };
type APICallTypeBreakdown = 
 record {
   callCount: nat32;
   objectTypeId: opt ObjectId;
   totalCost: TokenAmt;
   typeName: text;
 };
type APICallRecord = 
 record {
   apiKey: blob;
   batchSize: nat8;
   consumerId: ConsumerId;
   cost: TokenAmt;
   id: nat64;
   isBatch: bool;
   objectTypeId: opt ObjectId;
   status: text;
   timestamp: Timestamp;
 };
service : {
  /// Admin: register a new supported payment token.
  addAPIToken: (ledgerId: principal, symbol: text, decimals: nat8,
   minDeposit: TokenAmt) -> (APITokenId);
  addPost: (threadId: ThreadId, content: text) -> (PostId);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  banUser: (user: principal) -> ();
  /// Burn stake after dispute window closes on a rejected proposal.
  burnStake: (proposalId: ProposalId) -> (variant {
                                            err: text;
                                            ok;
                                          });
  createThread: (title: text, content: text) -> (ThreadId);
  /// Deduct the cost of an API call from consumer balance.
  /// Called internally before serving paid data queries.
  deductAPICall: (apiKey: blob, objectTypeId: opt ObjectId, isBatch: 
   bool, batchSize: nat8) -> (variant {
                                err: text;
                                ok;
                              });
  deletePost: (threadId: ThreadId, postId: PostId) -> ();
  deleteThread: (threadId: ThreadId) -> ();
  /// Deposit balance from caller's ICRC-1 account to their API consumer balance.
  /// Caller must have previously approved the canister on the ledger, or this does
  /// a pull via icrc1_transfer from caller subaccount.
  depositAPIBalance: (apiKey: blob, amount: nat64) ->
   (variant {
      err: text;
      ok;
    });
  /// Dispute an executed proposal within its dispute window.
  /// If disputeReward > 0%, pays reward % of stake from canister treasury to challenger.
  disputeProposal: (proposalId: ProposalId, _reason: text) -> ();
  /// Execute a proposal. Auto-returns stake on pass. Sets dispute window on both outcomes.
  executeProposal: (proposalId: ProposalId) -> ();
  /// Finalize a blob upload. Marks isActive = true after verifying all chunks uploaded.
  finalizeBlob: (blobId: BlobId, sha256: opt blob) ->
   (variant {
      err: text;
      ok;
    });
  getAPICallBreakdown: (fromTs: int, toTs: int) ->
   (variant {
      err: text;
      ok: vec APICallTypeBreakdown;
    });
  getAPICallHistory: (apiKey: blob, fromTs: int, toTs: int, page: nat32) ->
   (variant {
      err: text;
      ok: vec APICallRecord;
    });
  getAPIConsumer: () -> (opt APIConsumer) query;
  /// Look up a consumer by their API key (32-byte Blob).
  getAPIConsumerByKey: (apiKey: blob) -> (opt APIConsumerV2) query;
  /// Look up the caller's own consumer record.
  getAPIConsumerByPrincipal: () -> (opt APIConsumerV2) query;
  getAPIConsumers: () -> (vec APIConsumer) query;
  /// List all active price packages.
  getAPIPricePackages: () -> (vec APIPricePackage) query;
  getAPIRateLimitStatus: (apiKey: blob) ->
   (variant {
      err: text;
      ok: RateLimitStatus;
    });
  /// List all configured payment tokens.
  getAPITokens: () -> (vec APIToken) query;
  /// List all active frontend asset mappings as [(path, blobId)].
  getActiveFrontendAssets: () -> (vec record {
                                        text;
                                        BlobId;
                                      }) query;
  /// Look up the BlobEntry for a given active frontend path.
  getActiveFrontendBlob: (path: text) -> (opt BlobEntry) query;
  /// List all blob entries (active and inactive).
  getAllBlobEntries: () -> (vec BlobEntry) query;
  getAllConsumerKeys: () -> (vec APIConsumerV2) query;
  getAllObjectTypes: () -> (vec ObjectType) query;
  getAllProposals: () -> (vec Proposal) query;
  getAllThreads: () -> (vec Thread) query;
  /// Get a specific backup entry including the schema blob.
  getBackup: (id: BackupId) -> (opt BackupEntry) query;
  /// List all backup entries (metadata only, no blob data).
  getBackups: () ->
   (vec
     record {
       id: BackupId;
       objectCount: nat32;
       timestamp: int;
       triggeredBy: text;
     }) query;
  /// Retrieve a specific chunk by blobId + chunkIndex (0-based).
  getBlobChunk: (blobId: BlobId, chunkIndex: nat32) -> (opt blob) query;
  /// Get blob metadata by id.
  getBlobEntry: (id: BlobId) -> (opt BlobEntry) query;
  getCallTimeSeries: (fromTs: int, toTs: int, granularity: text) ->
   (variant {
      err: text;
      ok: vec TimeSeriesBucket;
    });
  /// Returns the caller's live ICFC ledger balance (convenience for frontend).
  getCallerICFCBalance: () -> (nat64);
  getCallerUserProfile: () -> (opt UserProfile) query;
  getCallerUserRole: () -> (UserRole) query;
  getDashboardConfig: () -> (opt DashboardConfig) query;
  getDashboardConfigs: () -> (vec DashboardConfig) query;
  getDynamicDocs: () -> (vec DynamicDoc) query;
  getEventLog: () -> (vec EventLogEntry) query;
  /// Get a single feed configuration.
  getFeedConfig: (id: FeedId) -> (opt FeedConfig) query;
  /// List all configured feed sources.
  getFeedConfigs: () -> (vec FeedConfig) query;
  /// Get all stored fetch results for a feed (up to last 10).
  getFeedResults: (feedId: FeedId) -> (vec FeedResult) query;
  getGovernanceSettings: () -> (GovernanceSettings) query;
  /// Reassemble all chunks in order and return body + mimeType for HTTP serving.
  /// Returns null if path not active, blob missing, or not finalized.
  getHTTPAsset: (path: text) ->
   (opt record {
          body: blob;
          mimeType: text;
        }) query;
  /// Query current heartbeat and system health status.
  getHeartbeatStatus: () ->
   (record {
      enabled: bool;
      heapSizeMb: nat32;
      lastBackupAt: nat64;
      lastRun: nat64;
      nextRun: nat64;
    }) query;
  /// Query the live ICFC ledger balance for any principal.
  getICFCBalance: ("principal": principal) -> (nat64);
  /// List all season import records.
  getImportHistory: () -> (vec ImportRecord) query;
  /// Get the most recent fetch result for a feed.
  getLatestFeedResult: (feedId: FeedId) -> (opt FeedResult) query;
  getObjectType: (id: ObjectId) -> (opt ObjectType) query;
  getProposal: (id: ProposalId) -> (opt Proposal) query;
  getTemplates: () -> (vec Template) query;
  getThread: (id: ThreadId) -> (opt Thread) query;
  getUserProfile: (user: principal) -> (opt UserProfile) query;
  /// Initiate a chunked blob upload. Returns a BlobId.
  /// Requires >= 1 ICFC. Creates an inactive BlobEntry.
  initBlobUpload: (name: text, mimeType: text, totalSize: nat32, chunkCount:
   nat32) -> (variant {
                err: text;
                ok: BlobId;
              });
  initializeAccessControl: () -> ();
  isCallerAdmin: () -> (bool) query;
  isUserBanned: (user: principal) -> (bool) query;
  /// Admin-only: manually trigger a feed fetch for testing.
  manualFetchFeed: (feedId: FeedId) -> (variant {
                                          err: text;
                                          ok: FeedResult;
                                        });
  pinPost: (threadId: ThreadId, postId: PostId) -> ();
  registerAPIConsumer: (apiKey: text, usageLimit: nat32) -> (ConsumerId);
  /// Register a new API key with the chosen payment token.
  registerAPIKey: (tokenId: APITokenId) -> (variant {
                                              err: text;
                                              ok: blob;
                                            });
  renameAPIKey: (apiKey: blob, newName: text) -> (variant {
                                                    err: text;
                                                    ok;
                                                  });
  /// Admin: reset shard-proposal-pending flag after a sharding proposal resolves.
  resetShardProposalPending: () -> ();
  /// Admin: log a rollback intent from a backup. Full schema re-application
  /// requires a #RestoreSchema DAO proposal for auditability.
  restoreFromBackup: (backupId: BackupId) -> (variant {
                                                err: text;
                                                ok;
                                              });
  /// Return stake from canister to the proposer of a passed proposal.
  returnStake: (proposalId: ProposalId) -> (variant {
                                              err: text;
                                              ok;
                                            });
  revokeAPIKey: (apiKey: blob) -> (variant {
                                     err: text;
                                     ok;
                                   });
  rotateAPIKey: (apiKey: blob) -> (variant {
                                     err: text;
                                     ok: blob;
                                   });
  saveCallerUserProfile: (profile: UserProfile) -> ();
  saveDashboardConfig: (layout: text, widgets: vec text) -> ();
  /// Admin: toggle heartbeat on/off and restart the timer immediately.
  setHeartbeatEnabled: (enabled: bool) -> ();
  simulateProposal: (proposalId: ProposalId) -> (text);
  /// Submit a proposal. Requires >= 1 ICFC on ledger and stake >= minStake.
  /// Frontend must pre-transfer `stake` e8s to the canister principal before calling.
  submitProposal: (proposalType: ProposalType, stake: TokenAmt, content:
   text) -> (ProposalId);
  /// Public heartbeat trigger (admin only — normally called by heartbeat timer).
  triggerFeedPoll: () -> ();
  /// Admin: trigger a manual backup immediately.
  triggerManualBackup: () -> (BackupId);
  unbanUser: (user: principal) -> ();
  /// Admin: mark an import record's status (e.g. "ok" or "error: <msg>").
  updateImportStatus: (importId: nat32, status: text) -> ();
  /// Upload a single chunk. chunkIndex is 0-based.
  uploadBlobChunk: (blobId: BlobId, chunkIndex: nat32, data: blob) ->
   (variant {
      err: text;
      ok;
    });
  /// Vote on a proposal. Voting power = real-time ICFC ledger balance (e8s).
  /// Caller must hold >= 1 e8 to vote.
  voteOnProposal: (proposalId: ProposalId, inFavor: bool) -> ();
}
